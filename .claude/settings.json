{
  "permissions": {
    "deny": [
      "Edit(.agents/guardia.py)",
      "Write(.agents/guardia.py)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Edit(config.json)",
      "Read(.env)",
      "Read(**/.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.agents/guardia.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
